{
  "name": "lucidindex",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lucidindex/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm tsc -b --noEmit && pnpm -r --if-present typecheck",
    "lint": "pnpm biome check",
    "format": "pnpm biome format --write",
    "prepare": "lefthook install",
    "db:generate": "pnpm --filter @lucidindex/db db:generate",
    "db:migrate": "pnpm --filter @lucidindex/db db:migrate",
    "db:studio": "pnpm --filter @lucidindex/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "lefthook": "^2.1.6",
    "typescript": "^6.0.3"
  }
}
