{
  "name": "@lucidindex/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./client": {
      "source": "./client.ts",
      "default": "./dist/client.js"
    },
    "./schema": {
      "source": "./schema/index.ts",
      "default": "./dist/schema/index.js"
    },
    "./query": {
      "source": "./query.ts",
      "default": "./dist/query.js"
    },
    "./seed": {
      "source": "./seed.ts",
      "default": "./dist/seed.js"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ],
      "schema": [
        "./dist/schema/index.d.ts"
      ],
      "query": [
        "./dist/query.d.ts"
      ],
      "seed": [
        "./dist/seed.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx seed.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lucidindex/templates": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "tsx": "4.20.6",
    "@types/node": "25.6.0"
  }
}
