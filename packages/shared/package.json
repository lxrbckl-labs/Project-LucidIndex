{
  "name": "@lucidindex/shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./slug": {
      "source": "./src/slug.ts",
      "default": "./dist/slug.js"
    }
  },
  "typesVersions": {
    "*": {
      "slug": [
        "./dist/slug.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "vitest": "3.2.4"
  }
}
