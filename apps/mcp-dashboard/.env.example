# `@lucidindex/mcp-dashboard` — environment variables.
#
# Source of truth: `apps/mcp-dashboard/src/env.ts`. Required vars fail
# fast at module-load time with a `FATAL:` message; optional vars fall
# back to the defaults shown below.
#
# Copy to `.env` and edit. The compose deployment reads these from the
# top-level `.env` next to `docker-compose.yml`.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Postgres connection string. Shared with apps/web — same Postgres, same
# schema. The sidecar never runs migrations itself; it expects the web
# entrypoint to have applied the latest schema first.
DATABASE_URL=postgres://lucidindex:lucidindex_dev@localhost:5432/lucidindex

# ---------------------------------------------------------------------------
# OPTIONAL — transport
# ---------------------------------------------------------------------------

# `http` (Streamable HTTP with bearer-token auth) or `stdio` (process-local,
# no auth). Default: http.
MCP_DASHBOARD_TRANSPORT=http

# Listen port (HTTP transport only). Bound to `0.0.0.0` inside the
# container; docker-compose maps it to `127.0.0.1:4000` on the host so it
# never reaches the LAN. Default: 4000.
MCP_DASHBOARD_PORT=4000

# CORS allowlist for the Streamable HTTP transport (audit round 6).
# Comma-separated list of permitted Origin headers, or `*` (default)
# for any origin. With an explicit list the server echoes back the
# request Origin only when it matches an entry; non-matching origins
# get no Access-Control-Allow-Origin (browser blocks the request).
# Bearer auth is header-based so opening this surface widely does not
# expose ambient credentials — narrow it only when fronting a known
# dashboard origin. Default: *.
# MCP_DASHBOARD_CORS_ORIGINS=*
# MCP_DASHBOARD_CORS_ORIGINS=https://dashboard.example.com,https://admin.example.com

# ---------------------------------------------------------------------------
# OPTIONAL — queue claim-lock TTL
# ---------------------------------------------------------------------------

# Claim-lock TTL for `pull_queue_item`. The agent has this long after
# pulling to ack before the dead-lock reaper releases the row back to the
# pool. Preferred (per #42 spec). Default: 15.
MCP_DASHBOARD_LOCK_TTL_MINUTES=15

# Legacy seconds-form of the lock TTL. Kept for back-compat. Ignored when
# MCP_DASHBOARD_LOCK_TTL_MINUTES is set. No default.
# MCP_DASHBOARD_QUEUE_LOCK_TTL_SEC=900

# ---------------------------------------------------------------------------
# OPTIONAL — hero-image pipeline (un-namespaced; shared with apps/web + apps/cron)
# ---------------------------------------------------------------------------

# On-disk directory where the hero-image pipeline writes resized
# WebP/JPEG outputs. Shared with apps/web (image-serve route) and
# apps/cron (retention purge); all three resolve to the same volume.
# Default: data/images (relative to the sidecar's cwd).
MCP_IMAGE_DIR=data/images

# Per-fetch budget (abort on timeout). Default: 10000 ms.
MCP_IMAGE_FETCH_TIMEOUT_MS=10000

# Per-fetch byte cap (abort on overrun). Default: 26214400 (25 MB).
MCP_IMAGE_MAX_BYTES=26214400

# Resize target width. Wider images are scaled down preserving aspect
# ratio; narrower images pass through untouched. Default: 1600.
MCP_IMAGE_MAX_WIDTH=1600

# ---------------------------------------------------------------------------
# OPTIONAL — runtime
# ---------------------------------------------------------------------------

# Standard Node env flag. Default: production.
NODE_ENV=production
