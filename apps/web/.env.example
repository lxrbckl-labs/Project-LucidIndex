# LucidIndex env vars (placeholders — real values land in subsequent tickets)
DATABASE_URL=postgres://lucidindex:lucidindex@localhost:5432/lucidindex

# iron-session cookie encryption. Generate a 32+ character secret with:
#   openssl rand -hex 32
IRON_SESSION_PASSWORD=replace-me-with-32-plus-char-hex-string

# WebAuthn relying-party config. Defaults below are fine for local dev;
# production values land in #86.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# docker-compose Postgres password. Used by the `postgres` service and
# echoed into DATABASE_URL by the compose file. Change for production.
POSTGRES_PASSWORD=lucidindex_dev

# Round 7 — first-deploy founding-admin token. Required for the founding-admin claim.
# Generate with: openssl rand -hex 32
# Drop from env after the founding admin has claimed (the token hash is recorded on the admins row).
LUCIDINDEX_FOUNDING_TOKEN=
