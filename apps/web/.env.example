# LucidIndex env vars (placeholders — real values land in subsequent tickets)
DATABASE_URL=postgres://lucidindex:lucidindex@localhost:5432/lucidindex

# iron-session cookie encryption. Generate a 32+ character secret with:
#   openssl rand -hex 32
IRON_SESSION_PASSWORD=replace-me-with-32-plus-char-hex-string

# WebAuthn relying-party config. Defaults below are fine for local dev;
# production values land in #86.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# docker-compose Postgres password. Used by the `postgres` service and
# echoed into DATABASE_URL by the compose file. Change for production.
POSTGRES_PASSWORD=lucidindex_dev

# Round 7 — first-deploy founding-admin token. Required for the founding-admin claim.
# Generate with: openssl rand -hex 32
# Drop from env after the founding admin has claimed (the token hash is recorded on the admins row).
LUCIDINDEX_FOUNDING_TOKEN=

# ---------------------------------------------------------------------------
# Demo-data seeder (LUCIDINDEX_SEED_DEMO)
# ---------------------------------------------------------------------------
#
# When set to `true`, `1`, or `yes` (case-insensitive), the web entrypoint
# runs packages/db/seed-demo.ts AFTER migrations + the standard idempotent
# seed. It populates an EMPTY database with a large synthetic fixture so
# Alex can stress-test the dashboard, FTS / search, masonry layout,
# mobile, retention purge, and share-link unfurl without real data.
#
# What it seeds (deterministic — faker is seeded with a fixed RNG so the
# same env produces the same fixtures):
#   - 50–80 targets across all source types (youtube/blog/newsletter/news
#     /instagram/x/website), real-feeling labels, ~80% active
#   - 15–25 topic_badges from a curated editorial-category pool
#   - 800–1200 articles with realistic titles + 3–5 sentence summaries +
#     deep-dive bodies, 1–3 badges each, recency-weighted publish dates
#     across the last 6 months, ~10% high-significance, ~5% starred,
#     ~5% hidden
#   - Hero images fetched from picsum.photos and run through the SAME
#     production image-pipeline used by mcp-store — disk layout, content
#     hashes, WebP+JPEG outputs all identical to real agent writes
#   - 10–20 pending topic_badge_suggestions (for the bulk-actions UI)
#   - 5–10 live queue items in mixed claimed/unclaimed states
#   - 30–50 run_log rows + ~50 cron_runs rows (System dashboard observability)
#
# What it NEVER seeds (governed by other flows):
#   - admins, credentials, recovery_codes — founding-admin claim flow
#   - agent_tokens (real ones) — operator-issued token flow
#   - auth_events — append-only audit log
#
# Idempotency: ONLY fires when both `targets` AND `articles` are empty.
# If either has any row, the seeder logs and exits without doing anything,
# protecting against double-seeding on container restarts. Drop the
# pg_data volume (`docker compose down -v`) to re-seed a fresh DB.
#
# Default: false. Production deployments should leave this off.
LUCIDINDEX_SEED_DEMO=false

# Hero-image pipeline config — used by mcp-store for production agent
# writes AND by the demo seeder for stress-test images. Defaults are
# fine for local + production unless you need to tighten budgets.
# MCP_IMAGE_DIR=data/images
# MCP_IMAGE_FETCH_TIMEOUT_MS=10000
# MCP_IMAGE_MAX_BYTES=26214400
# MCP_IMAGE_MAX_WIDTH=1600
