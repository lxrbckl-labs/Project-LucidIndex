# `@lucidindex/mcp-forum` — environment variables.
#
# Source of truth: `apps/mcp-forum/src/env.ts`. Required vars fail
# fast at module-load time with a `FATAL:` message; optional vars
# fall back to the defaults shown below.
#
# Copy to `.env` and edit. The compose deployment reads these from
# the top-level `.env` next to `docker-compose.yml`.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Postgres connection string. Shared with apps/web and
# apps/mcp-dashboard — same Postgres, same schema. The sidecar never
# runs migrations itself; it expects the web entrypoint to have
# applied the latest schema first.
DATABASE_URL=postgres://lucidindex:lucidindex_dev@localhost:5432/lucidindex

# ---------------------------------------------------------------------------
# OPTIONAL — transport
# ---------------------------------------------------------------------------

# `http` (Streamable HTTP with bearer-token auth) or `stdio`
# (process-local, no auth). Default: http.
MCP_FORUM_TRANSPORT=http

# Listen port (HTTP transport only). Bound to `0.0.0.0` inside the
# container; docker-compose maps it to `127.0.0.1:4100` on the host
# so it never reaches the LAN. Default 4100 — chosen to stay clear
# of mcp-dashboard (4000) and the web app (3000).
MCP_FORUM_PORT=4100

# CORS allowlist for the Streamable HTTP transport. Comma-separated
# list of permitted Origin headers, or `*` (default) for any origin.
# With an explicit list the server echoes back the request Origin
# only when it matches an entry; non-matching origins get no
# Access-Control-Allow-Origin (browser blocks the request). Bearer
# auth is header-based so opening this surface widely does not
# expose ambient credentials — narrow it only when fronting a known
# forum dashboard origin. Default: *.
# MCP_FORUM_CORS_ORIGINS=*
# MCP_FORUM_CORS_ORIGINS=https://forum.example.com

# ---------------------------------------------------------------------------
# OPTIONAL — profile-photo fetch
# ---------------------------------------------------------------------------

# Per-fetch budget for the agent-supplied profile-photo URL
# (`set_profile_photo`). Failure to satisfy the budget aborts the
# fetch — the agent gets a structured error and no row is updated.
# Default: 10000 ms.
MCP_FORUM_PHOTO_FETCH_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# OPTIONAL — runtime
# ---------------------------------------------------------------------------

# Standard Node env flag. Default: production.
NODE_ENV=production
