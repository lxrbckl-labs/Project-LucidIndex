# Keep build context lean — pnpm and Next.js rebuild inside the image.

# Dependencies — rebuilt from lockfile inside image
node_modules
**/node_modules

# Next.js build output — rebuilt inside image
.next
**/.next

# pnpm store cache
.pnpm-store
**/.pnpm-store

# Environment files — never bake secrets into images.
# Patterns are also `**/`-prefixed so nested copies are excluded too — notably
# `apps/web/.env`, which is a symlink to the root `.env`. Without excluding it,
# the image gets a DANGLING symlink (its target `.env` is ignored), and Next's
# standalone build fails: `ENOENT: stat '/app/apps/web/.env'`.
.env
.env.local
.env.*
**/.env
**/.env.local
**/.env.*
!.env.example
!**/.env.example

# Git metadata
.git
.github
.gitignore

# Logs
logs
*.log

# OS / editor artifacts
.DS_Store
*.swp
*.swo

# Data directories
data
**/data

# Test / coverage outputs
coverage
test-results
playwright-report

# Leftover lock files that shouldn't override the workspace lockfile
yarn.lock
package-lock.json
